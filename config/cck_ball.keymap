#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    new_behavior: new_behavior {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
        label = "NEW_BEHAVIOR";
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        line {
            bindings = <&kp LS(LC(SPACE))>;
            key-positions = <3 4>;
        };

        lie {
            bindings = <&kp LA(LC(SPACE))>;
            key-positions = <3 16>;
        };

        sz {
            bindings = <&kp LS(LC(V))>;
            key-positions = <27 28>;
        };

        shaixuan {
            bindings = <&kp LS(LC(L))>;
            key-positions = <20 21>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        shunshi {
            bindings = <&mkp MB2>;
            key-positions = <42 43>;
        };

        enter {
            bindings = <&mkp MB1>;
            key-positions = <40 41>;
        };

        reset {
            bindings = <&tog 0>;
            key-positions = <36 37 38>;
        };

        lanya {
            bindings = <&mo 1>;
            key-positions = <36 47>;
        };
    };

    macros {
        pw1: pw1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp J &kp Z &kp N5 &kp N1 &kp N0 &kp N1 &kp N0 &kp N2 &kp N4>;
            label = "PW1";
        };

        pw2: pw2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp L &kp H &kp N1 &kp N4 &kp N8 &kp N9 &kp N5 &kp N2>;
            label = "PW2";
        };

        pw3: pw3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Z) &kp Z &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp AT>;
            label = "PW3";
        };

        pw4: pw4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6>;
            label = "PW4";
        };

        sc: sc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&mkp MB1 &kp LC(A) &kp LC(V)>,
                <&macro_wait_time 100>,
                <&kp TAB &kp SPACE &kp LA(TAB)>,
                <&macro_wait_time 500>,
                <&kp DOWN_ARROW>,
                <&macro_wait_time 100>,
                <&kp LC(C) &kp LA(TAB)>;

            label = "SC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E         &kp R        &kp T     &kp Y     &kp U      &kp I             &kp O                &kp P                   &kp BACKSPACE
&kp LEFT_SHIFT    &kp A  &kp S  &kp D         &kp F        &kp G     &kp H     &kp J      &kp K             &kp L                &mt GRAVE SINGLE_QUOTE  &kp MINUS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C         &kp V        &kp B     &kp N     &kp M      &mt PERIOD COMMA  &mt SEMICOLON SLASH  &kp UP                  &kp EQUAL
&mo 3             &mo 2  &mo 1  &kp LEFT_ALT  &lt 3 ENTER  &mkp MB2  &mkp MB1  &kp SPACE  &lt 3 DEL         &kp LEFT_ARROW       &kp DOWN_ARROW          &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&inc_dec_kp MINUS EQUAL>,
                <&scroll_vertical_encoder>;
        };

        layer_5 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        symbo_layers {
            bindings = <
&none  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)    &kp LS(LPAR)  &kp LS(RPAR)  &kp LEFT_WIN
&none  &none     &none   &none     &none       &kp GRAVE    &kp MINUS      &kp EQUAL     &kp LBKT        &kp RBKT      &kp BSLH      &none
&none  &none     &none   &none     &none       &kp TILDE    &kp UNDER      &kp PLUS      &kp LEFT_BRACE  &kp RBRC      &kp PIPE      &none
&none  &none     &none   &none     &mo 3       &none        &none          &none         &none           &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        settings-layers {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4    &kp N5          &kp N7  &kp N8  &kp N9      &kp FSLH   &pw1  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4    &kp F5          &kp N4  &kp N5  &kp N6      &kp STAR   &pw2  &trans
&trans  &trans  &trans  &trans  &kp CAPS  &kp KP_NUMLOCK  &kp N1  &kp N2  &kp N3      &kp MINUS  &pw3  &trans
&trans  &trans  &trans  &trans  &trans    &trans          &trans  &kp N0  &kp KP_DOT  &kp PLUS   &pw4  &sc
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,，,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };
};
